{
  "version": 1,
  "author": "Tanisha Karan",
  "editor": "wokwi",

  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -40,
      "left": -180,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
      "id": "potVoltage",
      "top": 140,
      "left": -180,
      "attrs": {
        "value": "50"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "potCurrent",
      "top": 280,
      "left": -180,
      "attrs": {
        "value": "30"
      }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -60,
      "left": 180,
      "attrs": {
        "i2cAddress": "0x3C"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 220,
      "left": 180,
      "attrs": {
        "color": "green"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "button1",
      "top": 320,
      "left": 180,
      "attrs": {
        "color": "blue",
        "xray": "1"
      }
    }
  ],

  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:SDA", "esp:4", "green", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],

    [ "potVoltage:VCC", "esp:3V3", "red", [] ],
    [ "potVoltage:SIG", "esp:34", "green", [] ],
    [ "potVoltage:GND", "esp:GND.2", "black", [] ],

    [ "potCurrent:VCC", "esp:3V3", "red", [] ],
    [ "potCurrent:SIG", "esp:35", "green", [] ],
    [ "potCurrent:GND", "esp:GND.2", "black", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.3", "black", [] ],
    [ "oled1:SCL", "esp:22", "green", [] ],
    [ "oled1:SDA", "esp:21", "green", [] ],

    [ "led1:A", "esp:5", "green", [] ],
    [ "led1:C", "esp:GND.3", "black", [] ],

    [ "button1:1.l", "esp:18", "green", [] ],
    [ "button1:2.l", "esp:GND.4", "black", [] ]
  ],

  "dependencies": {}
}